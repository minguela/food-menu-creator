# Neon PostgreSQL Database (replaces Supabase)
NEON_DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@your-host.eu-west-2.aws.neon.tech/menuplanner?sslmode=require

# Site URL (usado para SEO: og:image, canonical, etc.)
NUXT_PUBLIC_SITE_URL=https://tu-dominio.vercel.app

# OCR Processor Backend (server-only)
# vacio  = usar Docker OCR via Tailscale
# local  = http://100.121.143.66:8086/ (solo desarrollo en Tailscale VPN)
# funnel = <production-ocr-url> (Tailscale Funnel, PUBLICO)
OCR_PROCESSOR_URL=
OCR_SHARED_SECRET=

# Telegram Bot (opcional)
TELEGRAM_BOT_TOKEN=
NUXT_PUBLIC_ADMIN_TELEGRAM_ID=

# USDA Food Data Central API
USDA_FDC_API_KEY=
