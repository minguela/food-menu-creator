{
  "name": "menu-web",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "lint:dark": "node ./scripts/check-dark-classes.mjs",
    "lint:confirm": "node ./scripts/check-no-browser-confirm.mjs",
    "lint": "nuxt typecheck",
    "lint:full": "nuxt typecheck && npm run lint:dark && npm run lint:confirm && npx -y prettier@3.6.2 --check .",
    "health-check": "node ./health-check.js",
    "preview": "nuxt preview",
    "test:nutrition": "playwright test --config=playwright.config.ts tests/nutrition-generator.spec.ts --reporter=line --workers=1",
    "test:ocr": "playwright test tests/ocr-processor.spec.ts",
    "test:rotating:playwright": "playwright test --config=playwright.config.ts tests/rotating-portion-scaling.spec.ts",
    "test:rotating": "node --test tests/rotating-weekly-menu-blocks.test.mjs tests/rotating-menu-completeness.test.mjs tests/rotating-portion-scaling.test.mjs",
    "test:rotating:live": "node tests/rotating-menu-live.mjs",
    "test": "node --test tests/*.test.mjs && npm run build",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "nuxt": "^4.4.5",
    "vue": "^3.5.34",
    "vue-router": "^4.6.4",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@playwright/test": "^1.60.0"
  }
}
