# Supabase Configuration
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Site URL (usado para SEO: og:image, canonical, etc.)
NUXT_PUBLIC_SITE_URL=https://tu-dominio.vercel.app

# OCR Processor Backend (server-only, nunca expuesto al cliente)
# vacio  = usar Supabase Edge Function (default, fallback automatico)
# local  = http://100.121.143.66:8086/ (solo desarrollo en Tailscale VPN)
# funnel = <production-ocr-url> (Tailscale Funnel, PUBLICO)
# custom = https://ocr.tu-dominio.com/ (Cloudflare Tunnel, VPS, etc.)
# NOTA: La URL del Tailscale Funnel es accesible desde Vercel (HTTPS publico).
OCR_PROCESSOR_URL=

# Seguridad: header secreto para proteger el endpoint POST del OCR Docker
# Solo se envia desde el servidor (server/api/ocr.post.ts)
# El cliente NUNCA ve este valor.
OCR_SHARED_SECRET=

# Telegram Bot (opcional, para webhook)
TELEGRAM_BOT_TOKEN=
